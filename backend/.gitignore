############################################
# SERVER CONFIGURATION
############################################

PORT=5000
NODE_ENV=development
APP_NAME=SmartSalonAPI
API_VERSION=v1



############################################
# DATABASE CONFIGURATION
############################################

MONGO_URI=mongodb://127.0.0.1:27017/smart_salon

# Optional MongoDB Atlas example
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/smart_salon



############################################
# JWT AUTHENTICATION
############################################

JWT_SECRET=super_secret_jwt_key_change_this
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=refresh_secret_key_change_this
JWT_REFRESH_EXPIRE=30d



############################################
# REDIS CONFIGURATION (CACHE + QUEUES)
############################################

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0



############################################
# SMS SERVICE (OTP SYSTEM)
############################################

SMS_PROVIDER=console
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=SMTSLN
SMS_API_URL=https://api.msg91.com/api/v5/flow/



############################################
# FILE UPLOAD SETTINGS
############################################

UPLOAD_PATH=src/uploads
MAX_FILE_SIZE=5242880



############################################
# RATE LIMIT SETTINGS
############################################

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100



############################################
# CACHE SETTINGS
############################################

SALON_CACHE_TTL=300
TRENDING_CACHE_TTL=600



############################################
# BOOKING SYSTEM SETTINGS
############################################

DEFAULT_SLOT_DURATION=30
BOOKING_BUFFER_TIME=5
BOOKING_ADVANCE_DAYS=30
BOOKING_EXPIRATION_MINUTES=15



############################################
# NOTIFICATION SETTINGS
############################################

BOOKING_REMINDER_MINUTES=60



############################################
# ADMIN DEFAULT ACCOUNT (OPTIONAL)
############################################

ADMIN_EMAIL=admin@smartsalon.com
ADMIN_PASSWORD=admin123



############################################
# LOGGING SETTINGS
############################################

LOG_LEVEL=debug
LOG_FILE=src/logs/app.log



############################################
# API DOCUMENTATION
############################################

SWAGGER_ENABLED=true
SWAGGER_ROUTE=/api-docs



node_modules
.env
logs
uploads
dist
coverage
.DS_Store